# ============================================================
# All-Access Peptides — environment variables
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- Database ---
# Dev (SQLite): file:./dev.db   (path is relative to prisma/)
# Production (Postgres): postgresql://user:pass@host:5432/dbname
#   -> also change prisma/schema.prisma datasource provider to "postgresql"
#      and regenerate migrations (see docs/DEPLOYMENT.md)
DATABASE_URL="file:./dev.db"

# --- Site ---
# Canonical site URL (used in emails, sitemap, Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Stripe (payments + tax) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret for the endpoint /api/webhooks/stripe
# (dashboard -> Developers -> Webhooks; listen for payment_intent.succeeded,
#  payment_intent.payment_failed, payment_intent.processing, charge.refunded)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email ---
# "console" logs emails to the server console (development).
# Leave unset with RESEND_API_KEY set to send via Resend.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""

# --- Scheduled jobs ---
# Shared secret for POST /api/cron/abandoned-carts
CRON_SECRET="generate-a-long-random-string"

# --- File storage ---
# Directory for private COA documents (must be persistent in production).
# Defaults to ./storage
FILE_STORAGE_DIR=""

# --- Initial Super Admin (used once by: npm run create-admin) ---
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
