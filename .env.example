# ============================================================
# All-Access Peptides — environment variables
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- Database ---
# Postgres connection string (Neon via Netlify DB, or any Postgres host).
# Use the read/write ("owner") connection string, not a read-only replica —
# migrations and normal app writes both need it.
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# --- Site ---
# Canonical site URL (used in emails, sitemap, Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Stripe (payments + tax) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret for the endpoint /api/webhooks/stripe
# (dashboard -> Developers -> Webhooks; listen for payment_intent.succeeded,
#  payment_intent.payment_failed, payment_intent.processing, charge.refunded)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email ---
# "console" logs emails to the server console (development).
# Set POSTMARK_API_TOKEN to send via Postmark (recommended — domain
# verification only needs TXT/CNAME records, no MX), or RESEND_API_KEY
# to send via Resend (requires an MX record on a subdomain).
EMAIL_PROVIDER="console"
POSTMARK_API_TOKEN=""
RESEND_API_KEY=""

# --- Scheduled jobs ---
# Shared secret for POST /api/cron/abandoned-carts
CRON_SECRET="generate-a-long-random-string"

# --- File storage ---
# Directory for private COA documents (must be persistent in production).
# Defaults to ./storage
FILE_STORAGE_DIR=""

# --- Initial Super Admin (used once by: npm run create-admin) ---
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
